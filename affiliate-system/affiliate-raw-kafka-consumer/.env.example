# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=affiliate.raw.events.v1
KAFKA_GROUP_ID=affiliar-raw-event-consumer

# ClickHouse
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_DATABASE=affiliate
CLICKHOUSE_USERNAME=admin
CLICKHOUSE_PASSWORD=password

# Batch
BATCH_SIZE=200
SEND_INTERVAL_MS=5000

# Mongo (for affiliateCode -> affiliate_id resolution)
MONGODB_URI=mongodb://affiliateAdmin:password@localhost:27017/affiliate?authSource=affiliate
MONGODB_DATABASE=affiliate
AFFILIATE_CACHE_REFRESH_MS=60000
